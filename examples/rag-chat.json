{
  "schema_version": 1,
  "flow_id": "33333333-3333-4333-8333-333333333333",
  "inputs": {
    "message": "string"
  },
  "outputs": {
    "reply": {
      "node": "reply",
      "output": "value"
    }
  },
  "nodes": [
    {
      "id": "message",
      "type": "input",
      "config": {
        "name": "message"
      },
      "bindings": {},
      "retry": {
        "max_attempts": 0
      },
      "timeout_ms": 1000
    },
    {
      "id": "sources",
      "type": "rag.retrieve",
      "config": {
        "top_k": 3
      },
      "bindings": {
        "query": {
          "node": "message",
          "output": "value"
        }
      },
      "retry": {
        "max_attempts": 0
      },
      "timeout_ms": 60000
    },
    {
      "id": "prompt",
      "type": "prompt.render",
      "config": {
        "template": "Answer the question using only the sources below. Cite document IDs. If no relevant source is available, say so.\n\nQuestion: {{question}}\n\nSources:\n{{text}}"
      },
      "bindings": {
        "text": {
          "node": "sources",
          "output": "context"
        },
        "question": {
          "node": "message",
          "output": "value"
        }
      },
      "retry": {
        "max_attempts": 0
      },
      "timeout_ms": 1000
    },
    {
      "id": "model",
      "type": "llm.chat",
      "config": {
        "model_alias": "mock",
        "max_output_tokens": 512
      },
      "bindings": {
        "prompt": {
          "node": "prompt",
          "output": "value"
        }
      },
      "retry": {
        "max_attempts": 1
      },
      "timeout_ms": 30000
    },
    {
      "id": "reply",
      "type": "output",
      "config": {},
      "bindings": {
        "value": {
          "node": "model",
          "output": "value"
        }
      },
      "retry": {
        "max_attempts": 0
      },
      "timeout_ms": 1000
    }
  ],
  "edges": [
    {
      "from": {
        "node": "message",
        "output": "value"
      },
      "to_node": "sources",
      "to_input": "query"
    },
    {
      "from": {
        "node": "sources",
        "output": "context"
      },
      "to_node": "prompt",
      "to_input": "text"
    },
    {
      "from": {
        "node": "prompt",
        "output": "value"
      },
      "to_node": "model",
      "to_input": "prompt"
    },
    {
      "from": {
        "node": "model",
        "output": "value"
      },
      "to_node": "reply",
      "to_input": "value"
    },
    {
      "from": {
        "node": "message",
        "output": "value"
      },
      "to_node": "prompt",
      "to_input": "question"
    }
  ],
  "limits": {
    "max_nodes": 16,
    "max_run_ms": 120000
  }
}
