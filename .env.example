DATABASE_URL=postgres://chatflow:chatflow@localhost:5432/chatflow
API_BIND=127.0.0.1:3000
WORKER_CONCURRENCY=4
RETENTION_SWEEP_SECONDS=3600
RUST_LOG=chatflow=info,api=info,worker=info
# Optional: export traces and run counters to the local OpenTelemetry collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
# GRAFANA_ADMIN_PASSWORD=local-dev-only
# Optional: enable the server-side "openai" model alias.
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# An OpenAI-compatible router may use a custom HTTPS base URL, such as
# https://llmrouterv2.aevai-health.com/openai. Set this on workers only.
# This router's tested Bedrock model ID is
# bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0.
# Vault KV v2 stores the provider api_key. Set these only on workers.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=local-dev-only
# VAULT_DEV_ROOT_TOKEN_ID=local-dev-only
# Required on the API before admitting "openai" transport runs, including Bedrock.
# Set rates for the selected model under your contract.
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=

# RAGFlow retrieval is configured on API and workers; never put its key in flow JSON.
# RAGFLOW_BASE_URL=https://ragflow.example.com
# The optional Compose app profile defaults to http://host.docker.internal:9380.
# RAGFLOW_API_KEY=
# RAGFLOW_API_KEY_FILE=.local/ragflow-api-key
# Configure each tenant's dataset IDs through PUT /v1/ragflow-datasets.
